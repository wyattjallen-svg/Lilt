<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.22000.0</SupportedOSPlatformVersion>
    <RootNamespace>Lilt.App</RootNamespace>
    <AssemblyName>Lilt</AssemblyName>
    <Version>0.4.0</Version>
    <Product>Lilt</Product>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\lilt.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- One GC thread instead of a background one: the UI heap is small, so pauses stay short and memory stays lower. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.3.9" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lilt.Core\Lilt.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Themes\*.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="NewTab\*.*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Extensions\ubol-key.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\lilt.ico" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="Browser\page.js" LogicalName="Lilt.App.Browser.page.js" />
  </ItemGroup>

  <!-- uBlock Origin Lite (GPL-3.0) is bundled from its official release, pinned by version and SHA-256. -->
  <PropertyGroup>
    <UbolVersion>2026.1018.2229</UbolVersion>
    <UbolSha256>c48dfa2f925ed31fdbd478d6b504432152ac995ab1e0fc96c3a008a0307dbbe2</UbolSha256>
    <UbolDir>$(BaseIntermediateOutputPath)uBOLite-$(UbolVersion)\</UbolDir>
  </PropertyGroup>

  <Target Name="FetchUbol" Condition="!Exists('$(UbolDir)manifest.json')">
    <DownloadFile SourceUrl="https://github.com/uBlockOrigin/uBOL-home/releases/download/$(UbolVersion)/uBOLite_$(UbolVersion).chromium.zip"
                  DestinationFolder="$(BaseIntermediateOutputPath)" DestinationFileName="uBOLite-$(UbolVersion).zip" Retries="3" />
    <VerifyFileHash File="$(BaseIntermediateOutputPath)uBOLite-$(UbolVersion).zip" Hash="$(UbolSha256)" Algorithm="SHA256" />
    <Unzip SourceFiles="$(BaseIntermediateOutputPath)uBOLite-$(UbolVersion).zip" DestinationFolder="$(UbolDir)" />
  </Target>

  <Target Name="IncludeUbol" DependsOnTargets="FetchUbol" BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <_Ubol Include="$(UbolDir)**\*" />
      <Content Include="@(_Ubol)" Link="Extensions\uBOLite\%(_Ubol.RecursiveDir)%(_Ubol.Filename)%(_Ubol.Extension)" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
