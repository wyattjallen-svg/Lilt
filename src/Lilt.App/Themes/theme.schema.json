{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lilt theme",
  "description": "Every setting is optional; missing or invalid values fall back to the built-in Dusk theme.",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "color": {
      "type": "string",
      "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
      "description": "#RGB, #RRGGBB or #RRGGBBAA (alpha last)."
    }
  },
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "integer",
      "minimum": 1,
      "description": "Format version. This version of Lilt reads version 1."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "base": {
      "enum": [
        "dark",
        "light"
      ],
      "description": "Base look for built-in controls and the color scheme websites see."
    },
    "backdrop": {
      "description": "Window material, as a name or with tint settings. Falls back to colors.background where unsupported.",
      "anyOf": [
        {
          "enum": [
            "mica",
            "micaAlt",
            "acrylic",
            "acrylicThin",
            "none"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "material": {
              "enum": [
                "mica",
                "micaAlt",
                "acrylic",
                "acrylicThin",
                "none"
              ]
            },
            "tint": {
              "$ref": "#/$defs/color",
              "description": "Tint color laid over the blur."
            },
            "tintOpacity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "0 is clear glass, 1 is solid tint."
            },
            "luminosityOpacity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "How much the material evens out bright and dark areas behind it."
            }
          }
        }
      ]
    },
    "colors": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "background": {
          "$ref": "#/$defs/color",
          "description": "Window fill when there is no backdrop, and auto-hide panels over the page."
        },
        "surface": {
          "$ref": "#/$defs/color",
          "description": "Toolbar and pinned sidebar, drawn over the backdrop."
        },
        "surfaceRaised": {
          "$ref": "#/$defs/color",
          "description": "Fields such as the address bar."
        },
        "border": {
          "$ref": "#/$defs/color"
        },
        "text": {
          "$ref": "#/$defs/color"
        },
        "textMuted": {
          "$ref": "#/$defs/color"
        },
        "accent": {
          "$ref": "#/$defs/color"
        },
        "onAccent": {
          "$ref": "#/$defs/color",
          "description": "Text on accent-colored fills."
        },
        "hover": {
          "$ref": "#/$defs/color"
        },
        "pressed": {
          "$ref": "#/$defs/color"
        },
        "page": {
          "$ref": "#/$defs/color",
          "description": "Shown before a page paints. Alpha is ignored."
        }
      }
    },
    "typography": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "family": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "size": {
          "type": "number",
          "minimum": 9,
          "maximum": 24
        },
        "weight": {
          "type": "integer",
          "minimum": 100,
          "maximum": 900
        }
      }
    },
    "shape": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "radius": {
          "type": "number",
          "minimum": 0,
          "maximum": 24,
          "description": "Panels."
        },
        "controlRadius": {
          "type": "number",
          "minimum": 0,
          "maximum": 24,
          "description": "Buttons and fields."
        },
        "borderWidth": {
          "type": "number",
          "minimum": 0,
          "maximum": 4
        }
      }
    },
    "density": {
      "enum": [
        "compact",
        "standard",
        "comfortable"
      ],
      "description": "Spacing scale: 4, 6 or 8 px units."
    },
    "toolbar": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "height": {
          "type": "number",
          "minimum": 32,
          "maximum": 64,
          "description": "48 or more uses tall window buttons."
        },
        "items": {
          "type": "array",
          "items": {
            "enum": [
              "back",
              "forward",
              "reload",
              "home",
              "address",
              "bookmark",
              "media",
              "split",
              "downloads",
              "extensions",
              "palette",
              "customize",
              "sidebar",
              "menu"
            ]
          },
          "uniqueItems": true,
          "description": "Toolbar elements in order. Items before \"address\" sit left of it, the rest right. Leave one out to hide it."
        }
      }
    },
    "sidebar": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "edge": {
          "enum": [
            "left",
            "right",
            "top",
            "bottom"
          ]
        },
        "width": {
          "type": "number",
          "minimum": 120,
          "maximum": 600,
          "description": "Used when docked left or right."
        },
        "height": {
          "type": "number",
          "minimum": 32,
          "maximum": 200,
          "description": "Used when docked top or bottom."
        },
        "autoHide": {
          "type": "boolean"
        },
        "revealEdge": {
          "type": "number",
          "minimum": 1,
          "maximum": 32,
          "description": "Pixels from the edge that reveal an auto-hide sidebar."
        },
        "hideDelay": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5000,
          "description": "Milliseconds before an auto-hide sidebar closes after the pointer leaves."
        },
        "sections": {
          "type": "array",
          "items": {
            "enum": [
              "tabs",
              "bookmarks",
              "layout"
            ]
          },
          "uniqueItems": true,
          "description": "Sidebar sections in order (top to bottom). Leave one out to hide it. Bookmarks only show when docked left or right."
        }
      }
    },
    "motion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "animations": {
          "type": "boolean",
          "description": "Also off when Windows animation effects are off."
        },
        "duration": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        }
      }
    },
    "pages": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "colorScheme": {
          "enum": [
            "theme",
            "auto",
            "light",
            "dark"
          ],
          "description": "The prefers-color-scheme websites see. theme follows base; auto follows Windows."
        },
        "peek": {
          "type": "boolean",
          "description": "Shift+click a link to preview it in a panel over the page."
        },
        "search": {
          "type": "string",
          "description": "Search engine: duckduckgo, google, bing, brave, startpage, ecosia, kagi, or an https address with %s where the words go.",
          "examples": [
            "duckduckgo",
            "google",
            "https://example.com/search?q=%s"
          ]
        },
        "history": {
          "type": "boolean",
          "description": "Remember visited pages for address-bar suggestions (never in InPrivate)."
        }
      }
    },
    "home": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "enum": [
              "logo",
              "clock",
              "search",
              "tiles",
              "hint",
              "gear"
            ]
          },
          "uniqueItems": true,
          "description": "Home tab elements in order, top to bottom. Leave one out to hide it."
        },
        "glass": {
          "type": "boolean",
          "description": "Transparent home tab so the window material shows through."
        },
        "background": {
          "type": "string",
          "maxLength": 100,
          "description": "\"\" for none, \"hills\" for built-in scenery, or an image file name (png, jpg, webp, gif, svg) in Lilt's newtab folder."
        },
        "clock": {
          "type": "boolean",
          "description": "Older setting; use items."
        },
        "search": {
          "type": "boolean",
          "description": "Older setting; use items."
        },
        "tiles": {
          "type": "boolean",
          "description": "Older setting; use items."
        }
      }
    },
    "power": {
      "type": "object",
      "additionalProperties": false,
      "description": "Power saving while you're in another app.",
      "properties": {
        "efficiency": {
          "type": "boolean",
          "description": "Lower Lilt's CPU priority (Windows efficiency mode) and memory use while another app is in front. Skipped while a tab plays sound."
        },
        "suspendMinutes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 240,
          "description": "Suspend tabs you haven't looked at for this long. 0 never suspends."
        },
        "hideWhenCovered": {
          "type": "boolean",
          "description": "Pause the visible page while a full-screen app or game covers Lilt's screen."
        },
        "hideWhenOccluded": {
          "type": "boolean",
          "description": "Hide (throttle, without suspending) the page while another window completely covers Lilt."
        },
        "lean": {
          "type": "boolean",
          "description": "Use less memory: Chromium's low-end-device mode and one process per site. Takes effect after a restart."
        }
      }
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "description": "Now-playing panel, visualizer and media keys.",
      "properties": {
        "player": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "show": {
              "enum": [
                "auto",
                "always",
                "never"
              ],
              "description": "auto: the player while something plays, the visualizer while a music site plays."
            },
            "x": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Left edge as a fraction of the page area."
            },
            "y": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Top edge as a fraction of the page area."
            },
            "width": {
              "type": "number",
              "minimum": 120,
              "maximum": 900
            },
            "height": {
              "type": "number",
              "minimum": 0,
              "maximum": 600,
              "description": "0 fits the content."
            },
            "opacity": {
              "type": "number",
              "minimum": 0.2,
              "maximum": 1
            }
          }
        },
        "visualizer": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "show": {
              "enum": [
                "auto",
                "always",
                "never"
              ],
              "description": "auto: the player while something plays, the visualizer while a music site plays."
            },
            "x": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Left edge as a fraction of the page area."
            },
            "y": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Top edge as a fraction of the page area."
            },
            "width": {
              "type": "number",
              "minimum": 120,
              "maximum": 900
            },
            "height": {
              "type": "number",
              "minimum": 0,
              "maximum": 600,
              "description": "0 fits the content."
            },
            "opacity": {
              "type": "number",
              "minimum": 0.2,
              "maximum": 1
            }
          }
        },
        "pip": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "show": {
              "enum": [
                "auto",
                "always",
                "never"
              ],
              "description": "auto: Windows' floating window when available, otherwise inside Lilt. always: always inside Lilt. never: off."
            },
            "x": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Left edge as a fraction of the page area."
            },
            "y": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Top edge as a fraction of the page area."
            },
            "width": {
              "type": "number",
              "minimum": 120,
              "maximum": 900
            },
            "height": {
              "type": "number",
              "minimum": 0,
              "maximum": 600,
              "description": "0 keeps 16:9."
            },
            "opacity": {
              "type": "number",
              "minimum": 0.2,
              "maximum": 1
            }
          }
        },
        "bars": {
          "type": "integer",
          "minimum": 4,
          "maximum": 96
        },
        "style": {
          "enum": [
            "bars",
            "mirror",
            "wave"
          ]
        },
        "source": {
          "enum": [
            "auto",
            "system",
            "page"
          ],
          "description": "system listens to Lilt's own audio (every site); page reads the playing tab (not DRM sites); auto tries system first."
        },
        "mediaKeys": {
          "type": "boolean",
          "description": "Keyboard media keys and the Windows media flyout control Lilt's tabs. Takes effect after a restart."
        },
        "autoPictureInPicture": {
          "type": "boolean",
          "description": "Pop a playing video out to picture-in-picture when you switch to another tab."
        },
        "musicSites": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Sites where the visualizer shows automatically."
        }
      }
    },
    "split": {
      "type": "object",
      "additionalProperties": false,
      "description": "Split view.",
      "properties": {
        "orientation": {
          "enum": [
            "horizontal",
            "vertical"
          ],
          "description": "horizontal: side by side; vertical: stacked."
        },
        "ratio": {
          "type": "number",
          "minimum": 0.15,
          "maximum": 0.85,
          "description": "The first pane's share."
        },
        "gap": {
          "type": "number",
          "minimum": 0,
          "maximum": 24
        }
      }
    },
    "shortcuts": {
      "type": "object",
      "additionalProperties": false,
      "description": "Keyboard shortcuts: \"Ctrl+Shift+K\", a list of them, or \"\" for none. Letters need Ctrl or Alt.",
      "properties": {
        "newTab": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "reopenTab": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "closeTab": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "nextTab": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "prevTab": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "address": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "back": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "forward": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "reload": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "home": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "bookmark": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "sidebar": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "menu": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "customize": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "palette": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "split": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "media": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "visualizer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "pip": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        }
      }
    }
  }
}
