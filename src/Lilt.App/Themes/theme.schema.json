{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lilt theme",
  "description": "Every setting is optional; missing or invalid values fall back to the built-in Dusk theme.",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "color": {
      "type": "string",
      "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
      "description": "#RGB, #RRGGBB or #RRGGBBAA (alpha last)."
    }
  },
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "integer",
      "minimum": 1,
      "description": "Format version. This version of Lilt reads version 1."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "base": {
      "enum": [
        "dark",
        "light"
      ],
      "description": "Base look for built-in controls and the color scheme websites see."
    },
    "backdrop": {
      "description": "Window material, as a name or with tint settings. Falls back to colors.background where unsupported.",
      "anyOf": [
        {
          "enum": [
            "mica",
            "micaAlt",
            "acrylic",
            "acrylicThin",
            "none"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "material": {
              "enum": [
                "mica",
                "micaAlt",
                "acrylic",
                "acrylicThin",
                "none"
              ]
            },
            "tint": {
              "$ref": "#/$defs/color",
              "description": "Tint color laid over the blur."
            },
            "tintOpacity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "0 is clear glass, 1 is solid tint."
            },
            "luminosityOpacity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "How much the material evens out bright and dark areas behind it."
            }
          }
        }
      ]
    },
    "colors": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "background": {
          "$ref": "#/$defs/color",
          "description": "Window fill when there is no backdrop, and auto-hide panels over the page."
        },
        "surface": {
          "$ref": "#/$defs/color",
          "description": "Toolbar and pinned sidebar, drawn over the backdrop."
        },
        "surfaceRaised": {
          "$ref": "#/$defs/color",
          "description": "Fields such as the address bar."
        },
        "border": {
          "$ref": "#/$defs/color"
        },
        "text": {
          "$ref": "#/$defs/color"
        },
        "textMuted": {
          "$ref": "#/$defs/color"
        },
        "accent": {
          "$ref": "#/$defs/color"
        },
        "onAccent": {
          "$ref": "#/$defs/color",
          "description": "Text on accent-colored fills."
        },
        "hover": {
          "$ref": "#/$defs/color"
        },
        "pressed": {
          "$ref": "#/$defs/color"
        },
        "page": {
          "$ref": "#/$defs/color",
          "description": "Shown before a page paints. Alpha is ignored."
        }
      }
    },
    "typography": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "family": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "size": {
          "type": "number",
          "minimum": 9,
          "maximum": 24
        },
        "weight": {
          "type": "integer",
          "minimum": 100,
          "maximum": 900
        }
      }
    },
    "shape": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "radius": {
          "type": "number",
          "minimum": 0,
          "maximum": 24,
          "description": "Panels."
        },
        "controlRadius": {
          "type": "number",
          "minimum": 0,
          "maximum": 24,
          "description": "Buttons and fields."
        },
        "borderWidth": {
          "type": "number",
          "minimum": 0,
          "maximum": 4
        }
      }
    },
    "density": {
      "enum": [
        "compact",
        "standard",
        "comfortable"
      ],
      "description": "Spacing scale: 4, 6 or 8 px units."
    },
    "scale": {
      "type": "number",
      "minimum": 0.75,
      "maximum": 1.5,
      "description": "Interface size: text, buttons, bars, the sidebar, the panel, widgets, menus and dialogs grow or shrink together (1 = 100%). Pages keep their own zoom."
    },
    "toolbar": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "height": {
          "type": "number",
          "minimum": 32,
          "maximum": 64,
          "description": "48 or more uses tall window buttons."
        },
        "items": {
          "type": "array",
          "items": {
            "enum": [
              "back",
              "forward",
              "reload",
              "home",
              "address",
              "bookmark",
              "media",
              "split",
              "panel",
              "downloads",
              "extensions",
              "palette",
              "customize",
              "sidebar",
              "menu"
            ]
          },
          "uniqueItems": true,
          "description": "Toolbar elements in order. Items before \"address\" sit left of it, the rest right. Leave one out to hide it."
        },
        "addressWidth": {
          "type": "number",
          "minimum": 300,
          "maximum": 2400,
          "description": "The address bar's widest width."
        },
        "siteColor": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "How strongly the toolbar takes on the color of the site you're on (0 = never)."
        }
      }
    },
    "sidebar": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "edge": {
          "enum": [
            "left",
            "right",
            "top",
            "bottom"
          ]
        },
        "width": {
          "type": "number",
          "minimum": 120,
          "maximum": 600,
          "description": "Used when docked left or right."
        },
        "height": {
          "type": "number",
          "minimum": 32,
          "maximum": 200,
          "description": "Used when docked top or bottom."
        },
        "autoHide": {
          "type": "boolean"
        },
        "revealEdge": {
          "type": "number",
          "minimum": 1,
          "maximum": 32,
          "description": "Pixels from the edge that reveal an auto-hide sidebar."
        },
        "hideDelay": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5000,
          "description": "Milliseconds before an auto-hide sidebar closes after the pointer leaves."
        },
        "sections": {
          "type": "array",
          "items": {
            "enum": [
              "tabs",
              "bookmarks",
              "layout"
            ]
          },
          "uniqueItems": true,
          "description": "Sidebar sections in order (top to bottom). Leave one out to hide it. Bookmarks only show when docked left or right."
        },
        "tabWidth": {
          "type": "number",
          "minimum": 100,
          "maximum": 400,
          "description": "A tab's width in a tab strip (sidebar along the top or bottom)."
        },
        "closeButtons": {
          "type": "boolean",
          "description": "Show an \u00d7 on every tab (middle-click and Ctrl+W still close tabs without it)."
        },
        "siteColor": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "How strongly the sidebar takes on the color of the site you're on (0 = never)."
        }
      }
    },
    "motion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "animations": {
          "type": "boolean",
          "description": "Also off when Windows animation effects are off."
        },
        "duration": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "windowDrag": {
          "type": "boolean",
          "description": "The window's content lifts slightly while you drag the window."
        }
      }
    },
    "pages": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "colorScheme": {
          "enum": [
            "theme",
            "auto",
            "light",
            "dark"
          ],
          "description": "The prefers-color-scheme websites see. theme follows base; auto follows Windows."
        },
        "peek": {
          "type": "boolean",
          "description": "Shift+click a link to preview it in a panel over the page."
        },
        "search": {
          "type": "string",
          "description": "Search engine: duckduckgo, google, bing, brave, startpage, ecosia, kagi, or an https address with %s where the words go.",
          "examples": [
            "duckduckgo",
            "google",
            "https://example.com/search?q=%s"
          ]
        },
        "history": {
          "type": "boolean",
          "description": "Remember visited pages for address-bar suggestions (never in InPrivate)."
        },
        "glass": {
          "type": "boolean",
          "description": "See-through websites: the window material shows behind pages. Can make some sites harder to read; turn it off per site with glassOff."
        },
        "glassOpacity": {
          "type": "number",
          "minimum": 0.2,
          "maximum": 1,
          "description": "How much of a page's own background color stays when glass is on."
        },
        "glassOff": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "description": "Sites (like \"mail.google.com\") that stay solid when glass is on."
        },
        "forceDark": {
          "type": "boolean",
          "description": "Darken websites that have no dark look of their own (after a restart)."
        },
        "tracking": {
          "enum": [
            "off",
            "basic",
            "balanced",
            "strict"
          ],
          "description": "Tracking prevention. strict blocks the most trackers and can break some sites."
        },
        "gestures": {
          "type": "boolean",
          "description": "Mouse gestures: hold the right button and draw. Left: back, right: forward, up then down: reload, down then right: close tab, down: new tab."
        },
        "scrollbars": {
          "enum": [
            "overlay",
            "classic"
          ],
          "description": "Thin overlay scrollbars or classic ones (after a restart)."
        },
        "restore": {
          "type": "boolean",
          "description": "Start with the tabs from last time. Off: a fresh home tab each start (the panel keeps its sites)."
        },
        "smoothScrolling": {
          "type": "boolean",
          "description": "Animated scrolling in pages. Off is instant and a little lighter. After a restart."
        },
        "universalFont": {
          "type": "boolean",
          "description": "Show every page's text in the font below (icons keep theirs). Changes apply to open pages at once."
        },
        "font": {
          "type": "string",
          "maxLength": 60,
          "description": "The font family for universalFont, e.g. \"Georgia\" or \"Atkinson Hyperlegible\". Letters, digits, spaces and hyphens only."
        }
      }
    },
    "home": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "enum": [
              "logo",
              "clock",
              "search",
              "tiles",
              "hint",
              "gear"
            ]
          },
          "uniqueItems": true,
          "description": "Home tab elements in order, top to bottom. Leave one out to hide it."
        },
        "glass": {
          "type": "boolean",
          "description": "Transparent home tab so the window material shows through."
        },
        "background": {
          "type": "string",
          "maxLength": 100,
          "description": "\"\" for none, \"hills\", \"aurora\" or \"waves\" (drawn from your colors), or an image file in the newtab folder."
        },
        "clock": {
          "type": "boolean",
          "description": "Older setting; use items."
        },
        "search": {
          "type": "boolean",
          "description": "Older setting; use items."
        },
        "tiles": {
          "type": "boolean",
          "description": "Older setting; use items."
        },
        "dim": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.8,
          "description": "Darkens a background image so the home tab stays readable."
        }
      }
    },
    "power": {
      "type": "object",
      "additionalProperties": false,
      "description": "Power saving while you're in another app.",
      "properties": {
        "efficiency": {
          "type": "boolean",
          "description": "Lower Lilt's CPU priority (Windows efficiency mode) and memory use while another app is in front. Skipped while a tab plays sound."
        },
        "suspendMinutes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 240,
          "description": "Suspend tabs you haven't looked at for this long. 0 never suspends."
        },
        "hideWhenCovered": {
          "type": "boolean",
          "description": "Pause the visible page while a full-screen app or game covers Lilt's screen."
        },
        "hideWhenOccluded": {
          "type": "boolean",
          "description": "Hide (throttle, without suspending) the page while another window completely covers Lilt."
        },
        "lean": {
          "type": "boolean",
          "description": "Use less memory: Chromium's low-end-device mode and one process per site. Takes effect after a restart."
        },
        "sleepMinutes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1440,
          "description": "Tabs you haven't looked at for this many minutes sleep: their page closes and uses no memory; the tab reloads when you open it (0 = never). Pinned tabs and tabs playing sound never sleep."
        },
        "sleepWhenLowMemory": {
          "type": "boolean",
          "description": "When Windows runs short of memory, tabs unused for 5 minutes sleep early."
        },
        "solidWhenAway": {
          "type": "boolean",
          "description": "While efficiency mode has Lilt in the background, the window material turns solid (saves the GPU work of Acrylic blurring what's behind)."
        }
      }
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "description": "Now-playing panel, visualizer and media keys.",
      "properties": {
        "player": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "show": {
              "enum": [
                "auto",
                "always",
                "never"
              ],
              "description": "auto: the player while something plays, the visualizer while a music site plays."
            },
            "x": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Left edge as a fraction of the page area."
            },
            "y": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Top edge as a fraction of the page area."
            },
            "width": {
              "type": "number",
              "minimum": 120,
              "maximum": 900
            },
            "height": {
              "type": "number",
              "minimum": 0,
              "maximum": 600,
              "description": "0 fits the content."
            },
            "opacity": {
              "type": "number",
              "minimum": 0.2,
              "maximum": 1
            }
          }
        },
        "visualizer": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "show": {
              "enum": [
                "auto",
                "always",
                "never"
              ],
              "description": "auto: the player while something plays, the visualizer while a music site plays."
            },
            "x": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Left edge as a fraction of the page area."
            },
            "y": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Top edge as a fraction of the page area."
            },
            "width": {
              "type": "number",
              "minimum": 120,
              "maximum": 900
            },
            "height": {
              "type": "number",
              "minimum": 0,
              "maximum": 600,
              "description": "0 fits the content."
            },
            "opacity": {
              "type": "number",
              "minimum": 0.2,
              "maximum": 1
            }
          }
        },
        "pip": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "show": {
              "enum": [
                "auto",
                "always",
                "never"
              ],
              "description": "auto: Windows' floating window when available, otherwise inside Lilt. always: always inside Lilt. never: off."
            },
            "x": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Left edge as a fraction of the page area."
            },
            "y": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Top edge as a fraction of the page area."
            },
            "width": {
              "type": "number",
              "minimum": 120,
              "maximum": 900
            },
            "height": {
              "type": "number",
              "minimum": 0,
              "maximum": 600,
              "description": "0 keeps 16:9."
            },
            "opacity": {
              "type": "number",
              "minimum": 0.2,
              "maximum": 1
            }
          }
        },
        "bars": {
          "type": "integer",
          "minimum": 4,
          "maximum": 96
        },
        "style": {
          "enum": [
            "bars",
            "mirror",
            "wave"
          ]
        },
        "source": {
          "enum": [
            "auto",
            "system",
            "page"
          ],
          "description": "system listens to Lilt's own audio (every site); page reads the playing tab (not DRM sites); auto tries system first."
        },
        "mediaKeys": {
          "type": "boolean",
          "description": "Keyboard media keys and the Windows media flyout control Lilt's tabs. Takes effect after a restart."
        },
        "autoPictureInPicture": {
          "type": "boolean",
          "description": "Pop a playing video out to picture-in-picture when you switch to another tab."
        },
        "musicSites": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Sites where the visualizer shows automatically."
        },
        "fps": {
          "type": "integer",
          "minimum": 10,
          "maximum": 60,
          "description": "How often the visualizer redraws per second (lower saves power)."
        }
      }
    },
    "split": {
      "type": "object",
      "additionalProperties": false,
      "description": "Split view.",
      "properties": {
        "orientation": {
          "enum": [
            "horizontal",
            "vertical"
          ],
          "description": "horizontal: side by side; vertical: stacked."
        },
        "ratio": {
          "type": "number",
          "minimum": 0.15,
          "maximum": 0.85,
          "description": "The first pane's share."
        },
        "gap": {
          "type": "number",
          "minimum": 0,
          "maximum": 24
        }
      }
    },
    "shortcuts": {
      "type": "object",
      "additionalProperties": false,
      "description": "Keyboard shortcuts: \"Ctrl+Shift+K\", a list of them, or \"\" for none. Letters need Ctrl or Alt.",
      "properties": {
        "newTab": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "reopenTab": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "closeTab": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "nextTab": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "prevTab": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "address": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "back": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "forward": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "reload": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "home": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "bookmark": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "sidebar": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "menu": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "customize": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "palette": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "split": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "media": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "visualizer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "pip": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "bookmarks": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "screenshot": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "workspace": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "panel": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "toPanel": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "sleepTabs": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "biggerUi": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "smallerUi": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "resetUi": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "logs": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
