{
  // Lilt theme. Save this file while Lilt is running and the window updates.
  // Colors are CSS-style: #RRGGBB or #RRGGBBAA (last pair is opacity).
  "$schema": "./theme.schema.json",
  "schemaVersion": 1,
  "name": "Dusk",
  "base": "dark",
  "backdrop": "mica",

  "colors": {
    "background": "#141318",
    "surface": "#1D1B23B3",
    "surfaceRaised": "#2A2733CC",
    "border": "#FFFFFF14",
    "text": "#ECE9F1",
    "textMuted": "#A19CAB",
    "accent": "#C4A7FF",
    "onAccent": "#1A1325",
    "hover": "#FFFFFF0F",
    "pressed": "#FFFFFF1A",
    "page": "#141318"
  },

  "typography": { "family": "Segoe UI Variable Text", "size": 13, "weight": 400 },
  "shape": { "radius": 8, "controlRadius": 6, "borderWidth": 1 },
  "density": "standard",

  "toolbar": { "height": 40 },
  "sidebar": {
    "edge": "left",
    "width": 248,
    "height": 48,
    "autoHide": false,
    "revealEdge": 6,
    "hideDelay": 350
  },
  "motion": { "animations": true, "duration": 160 },
  // theme follows "base"; auto follows Windows; or force light/dark for websites.
  "pages": { "colorScheme": "theme" },
  "home": { "clock": true, "search": true, "tiles": true, "glass": true }
}
