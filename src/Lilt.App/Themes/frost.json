{
  // Glass sample: thin acrylic with a light tint, translucent chrome, transparent home tab.
  "$schema": "./theme.schema.json",
  "schemaVersion": 1,
  "name": "Frost",
  "base": "dark",
  "backdrop": { "material": "acrylicThin", "tint": "#10131A", "tintOpacity": 0.15, "luminosityOpacity": 0.35 },

  "colors": {
    "background": "#14161C",
    "surface": "#14161C40",
    "surfaceRaised": "#FFFFFF14",
    "border": "#FFFFFF1F",
    "text": "#F2F4F8",
    "textMuted": "#B4BAC6",
    "accent": "#9CC9FF",
    "onAccent": "#0D1520",
    "hover": "#FFFFFF14",
    "pressed": "#FFFFFF24",
    "page": "#14161C"
  },

  "typography": { "family": "Segoe UI Variable Text", "size": 13, "weight": 400 },
  "shape": { "radius": 12, "controlRadius": 8, "borderWidth": 1 },
  "density": "standard",
  "toolbar": { "height": 40 },
  "sidebar": { "edge": "left", "width": 240, "height": 48, "autoHide": false, "revealEdge": 6, "hideDelay": 350 },
  "motion": { "animations": true, "duration": 160 },
  "pages": { "colorScheme": "theme" },
  "home": { "clock": true, "search": true, "tiles": true, "glass": true }
}
