{
  // A light sample. Copy it over theme.json in Lilt's data folder to use it.
  "$schema": "./theme.schema.json",
  "schemaVersion": 1,
  "name": "Paper",
  "base": "light",
  "backdrop": "micaAlt",

  "colors": {
    "background": "#F4F2ED",
    "surface": "#FBFAF7B3",
    "surfaceRaised": "#FFFFFFE6",
    "border": "#1A18201F",
    "text": "#1E1C22",
    "textMuted": "#6B6672",
    "accent": "#5B3FD0",
    "onAccent": "#FFFFFF",
    "hover": "#1A18200D",
    "pressed": "#1A182017",
    "page": "#FFFFFF"
  },

  "typography": { "family": "Segoe UI Variable Text", "size": 13, "weight": 400 },
  "shape": { "radius": 10, "controlRadius": 8, "borderWidth": 1 },
  "density": "comfortable",

  "toolbar": { "height": 48 },
  "sidebar": {
    "edge": "right",
    "width": 264,
    "height": 52,
    "autoHide": true,
    "revealEdge": 6,
    "hideDelay": 400
  },
  "motion": { "animations": true, "duration": 180 },
  "pages": { "colorScheme": "auto" }
}
