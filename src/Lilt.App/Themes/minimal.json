{
  // Lilt Minimal: the default. Save this file while Lilt is running and the window updates.
  // Colors are CSS-style: #RRGGBB or #RRGGBBAA (last pair is opacity).
  // Lists ("items", "sections") are ordered: move an id to move the element, delete it to hide it.
  "$schema": "./theme.schema.json",
  "schemaVersion": 1,
  "name": "Minimal",
  "base": "dark",
  "backdrop": "mica",

  "colors": {
    "background": "#171A1E",
    "surface": "#171A1EE6",
    "surfaceRaised": "#2A2F36",
    "border": "#FFFFFF12",
    "text": "#F3F4F1",
    "textMuted": "#9AA3AD",
    "accent": "#638B7B",
    "onAccent": "#F3F4F1",
    "hover": "#FFFFFF0D",
    "pressed": "#FFFFFF17",
    "page": "#171A1E"
  },

  "typography": { "family": "Segoe UI Variable Text", "size": 13, "weight": 400 },
  "shape": { "radius": 10, "controlRadius": 8, "borderWidth": 1 },
  "density": "standard",

  "toolbar": {
    "height": 40,
    "items": ["back", "forward", "reload", "home", "address", "bookmark", "downloads", "extensions", "customize", "sidebar", "menu"]
  },
  "sidebar": {
    "edge": "left",
    "width": 220,
    "height": 44,
    "autoHide": false,
    "revealEdge": 6,
    "hideDelay": 350,
    "sections": ["tabs", "bookmarks", "layout"]
  },
  "motion": { "animations": true, "duration": 160 },
  // theme follows "base"; auto follows Windows; or force light/dark for websites.
  "pages": { "colorScheme": "theme" },
  // items: logo, clock, search, tiles, hint, gear (the Customize button in the corner). background: "", "hills", or an image file in the newtab folder.
  "home": { "items": ["logo", "search", "tiles", "gear"], "glass": true, "background": "" },
  // While you're in another app: lower priority and memory, suspend idle tabs, pause pages hidden behind full-screen games.
  "power": { "efficiency": true, "suspendMinutes": 5, "hideWhenCovered": true }
}
