{
  // Lilt Minimal: the default. Save this file while Lilt is running and the window updates.
  // Colors are CSS-style: #RRGGBB or #RRGGBBAA (last pair is opacity).
  // Lists ("items", "sections") are ordered: move an id to move the element, delete it to hide it.
  "$schema": "./theme.schema.json",
  "schemaVersion": 1,
  "name": "Minimal",
  "base": "dark",
  "backdrop": "mica",

  "colors": {
    "background": "#171A1E",
    "surface": "#171A1EE6",
    "surfaceRaised": "#2A2F36",
    "border": "#FFFFFF12",
    "text": "#F3F4F1",
    "textMuted": "#9AA3AD",
    "accent": "#638B7B",
    "onAccent": "#F3F4F1",
    "hover": "#FFFFFF0D",
    "pressed": "#FFFFFF17",
    "page": "#171A1E"
  },

  "typography": { "family": "Segoe UI Variable Text", "size": 13, "weight": 400 },
  "shape": { "radius": 10, "controlRadius": 8, "borderWidth": 1 },
  "density": "standard",
  // Interface size, 0.75 to 1.5: text, buttons, bars, panels and widgets together. Pages keep their own zoom (Ctrl + and -).
  "scale": 1,

  // siteColor (here and in "sidebar"): how strongly it takes on the color of the site you're on, 0 to 1.
  "toolbar": {
    "height": 40,
    "addressWidth": 900,
    "siteColor": 0.45,
    "items": ["back", "forward", "reload", "home", "address", "bookmark", "media", "panel", "downloads", "extensions", "customize", "sidebar", "menu"]
  },
  "sidebar": {
    "edge": "left",
    "width": 220,
    "height": 44,
    "autoHide": false,
    "revealEdge": 6,
    "hideDelay": 350,
    "sections": ["tabs", "bookmarks", "layout"],
    // In a tab strip (sidebar at the top or bottom), each tab is this wide. closeButtons: an × on every tab.
    "tabWidth": 200,
    "closeButtons": true,
    "siteColor": 0.2
  },
  "motion": { "animations": true, "duration": 160, "windowDrag": true },
  // colorScheme: theme follows "base"; auto follows Windows; or force light/dark for websites.
  // search: duckduckgo, google, bing, brave, startpage, ecosia, kagi, or "https://...%s". glass: see-through websites
  // (glassOff lists sites to leave solid). forceDark and scrollbars apply after a restart. gestures: right-button drags.
  "pages": { "colorScheme": "theme", "peek": true, "search": "duckduckgo", "history": true,
    "glass": false, "glassOpacity": 0.72, "glassOff": [], "forceDark": false, "tracking": "balanced", "gestures": true, "scrollbars": "overlay" },
  // items: logo, clock, search, tiles, hint, gear (the Customize button in the corner). background: "", "hills", "aurora", "waves", or an image file in the newtab folder (dim darkens it).
  "home": { "items": ["logo", "search", "tiles", "gear"], "glass": true, "background": "", "dim": 0 },
  // While you're in another app: lower priority and memory, suspend idle tabs, pause pages hidden behind full-screen games.
  "power": { "efficiency": true, "suspendMinutes": 5, "hideWhenCovered": true, "hideWhenOccluded": true, "lean": false },
  // The "now playing" panel and visualizer float over the page; drag them anywhere (x and y are fractions of the page area).
  "media": {
    "player": { "show": "auto", "x": 0.66, "y": 0.74, "width": 300, "height": 0, "opacity": 1 },
    "visualizer": { "show": "auto", "x": 0.66, "y": 0.6, "width": 300, "height": 72, "opacity": 0.9 },
    // Videos popped out (Alt+P): "auto" uses Windows' floating window when it can, "always" keeps them inside Lilt.
    "pip": { "show": "auto", "x": 0.6, "y": 0.55, "width": 400, "height": 0, "opacity": 1 },
    "bars": 32, "style": "bars", "source": "auto", "mediaKeys": true, "autoPictureInPicture": false,
    "musicSites": ["music.youtube.com", "open.spotify.com", "soundcloud.com", "music.apple.com", "listen.tidal.com", "www.deezer.com",
      "bandcamp.com", "www.pandora.com", "music.amazon.com", "www.mixcloud.com", "tunein.com", "radio.garden"]
  },
  "split": { "orientation": "horizontal", "ratio": 0.5, "gap": 6 },
  // The panel beside the page (F4): drag a tab in to keep it there. sections, top to bottom: "web" (the tabs you put
  // there), "visualizer", "player"; leave the visualizer or player out to keep it floating over the page.
  "panel": { "edge": "right", "width": 380, "sections": ["web", "visualizer", "player"] },
  // cacheLimit: MB of cached files (0 = the engine decides; after a restart). forgetAfterDays: sites you haven't opened
  // in that long lose what they stored and their readable cookies; sign-ins stay unless signOut is true. keep: never touched.
  "storage": { "cacheLimit": 300, "forgetAfterDays": 90, "signOut": false, "keep": [] },
  // Change any shortcut: "command": "Ctrl+Shift+K", a list, or "" for none. Commands left out keep their defaults.
  "shortcuts": {}
}
