<Window
    x:Class="Lilt.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:browser="using:Lilt.App.Browser"
    xmlns:bm="using:Lilt.Core.Bookmarks"
    Title="Lilt">

  <Grid x:Name="Root" KeyboardAcceleratorPlacementMode="Hidden">
    <!-- Keyboard shortcuts are added in code from the theme's "shortcuts" block. -->
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Toolbar. It is also the title bar: empty space drags the window, controls are click-through regions. -->
    <Grid x:Name="Toolbar" Background="{StaticResource LiltSurfaceBrush}" BorderBrush="{StaticResource LiltBorderBrush}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition x:Name="DragColumn" Width="Auto" MinWidth="48" />
        <ColumnDefinition x:Name="CaptionColumn" Width="0" />
      </Grid.ColumnDefinitions>

      <!-- Toolbar elements are arranged by the theme's toolbar.items: those before the address bar go in LeftPanel, the rest in RightPanel. -->
      <StackPanel x:Name="LeftPanel" Orientation="Horizontal" VerticalAlignment="Center">
        <Button x:Name="BackButton" Style="{StaticResource ChromeButton}" Click="Back_Click" IsEnabled="False"
                ToolTipService.ToolTip="Back (Alt+Left)" AutomationProperties.Name="Back">
          <FontIcon Glyph="&#xE72B;" />
        </Button>
        <Button x:Name="ForwardButton" Style="{StaticResource ChromeButton}" Click="Forward_Click" IsEnabled="False"
                ToolTipService.ToolTip="Forward (Alt+Right)" AutomationProperties.Name="Forward">
          <FontIcon Glyph="&#xE72A;" />
        </Button>
        <Button x:Name="ReloadButton" Style="{StaticResource ChromeButton}" Click="Reload_Click"
                ToolTipService.ToolTip="Reload (F5)" AutomationProperties.Name="Reload">
          <FontIcon x:Name="ReloadIcon" Glyph="&#xE72C;" />
        </Button>
        <Button x:Name="HomeButton" Style="{StaticResource ChromeButton}" Click="Home_Click"
                ToolTipService.ToolTip="Home" AutomationProperties.Name="Home">
          <FontIcon Glyph="&#xE80F;" />
        </Button>
        <Button x:Name="StarButton" Style="{StaticResource ChromeButton}" Click="Star_Click"
                ToolTipService.ToolTip="Bookmark this page (Ctrl+D)" AutomationProperties.Name="Bookmark this page">
          <FontIcon x:Name="StarIcon" Glyph="&#xE734;" />
        </Button>
        <Button x:Name="DownloadsButton" Style="{StaticResource ChromeButton}" Visibility="Collapsed"
                ToolTipService.ToolTip="Downloads" AutomationProperties.Name="Downloads">
          <FontIcon Glyph="&#xE896;" />
          <Button.Flyout>
            <Flyout x:Name="DownloadsFlyout" Placement="BottomEdgeAlignedRight">
              <StackPanel Width="320" Spacing="8">
                <TextBlock Text="Downloads" Style="{StaticResource SectionHeader}" />
                <StackPanel x:Name="DownloadList" Spacing="4" />
                <TextBlock x:Name="NoDownloads" Text="Nothing downloaded yet" Style="{StaticResource BodyText}" Foreground="{StaticResource LiltTextMutedBrush}" />
              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>
        <Button x:Name="MediaButton" Style="{StaticResource ChromeButton}" Click="MediaButton_Click"
                ToolTipService.ToolTip="Now playing (Ctrl+Shift+M)" AutomationProperties.Name="Now playing">
          <FontIcon x:Name="MediaButtonIcon" Glyph="&#xE8D6;" />
        </Button>
        <Button x:Name="SplitButton" Style="{StaticResource ChromeButton}" Click="SplitButton_Click"
                ToolTipService.ToolTip="Split view (Ctrl+Shift+S)" AutomationProperties.Name="Split view">
          <FontIcon Glyph="&#xE8A9;" />
        </Button>
        <Button x:Name="PaletteButton" Style="{StaticResource ChromeButton}" Click="PaletteButton_Click"
                ToolTipService.ToolTip="Command palette (Ctrl+K)" AutomationProperties.Name="Command palette">
          <FontIcon Glyph="&#xE945;" />
        </Button>
        <Button x:Name="ExtensionsButton" Style="{StaticResource ChromeButton}" Click="Extensions_Click"
                ToolTipService.ToolTip="Extensions and ad blocker" AutomationProperties.Name="Extensions">
          <FontIcon Glyph="&#xEA86;" />
        </Button>
        <Button x:Name="CustomizeButton" Style="{StaticResource ChromeButton}" Click="CustomizeButton_Click"
                ToolTipService.ToolTip="Customize (Ctrl+Shift+,)" AutomationProperties.Name="Customize">
          <FontIcon Glyph="&#xE790;" />
        </Button>
        <Button x:Name="SidebarButton" Style="{StaticResource ChromeButton}" Click="SidebarButton_Click"
                ToolTipService.ToolTip="Sidebar (Ctrl+Shift+B)" AutomationProperties.Name="Show or hide sidebar">
          <FontIcon Glyph="&#xE8A0;" />
        </Button>
        <Button x:Name="MenuButton" Style="{StaticResource ChromeButton}" Click="MenuButton_Click"
                ToolTipService.ToolTip="Menu (Alt+F)" AutomationProperties.Name="Menu">
          <FontIcon Glyph="&#xE712;" />
        </Button>
      </StackPanel>

      <Grid x:Name="AddressHost" Grid.Column="1" MaxWidth="900" VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel x:Name="InsecureChip" Orientation="Horizontal" Spacing="4" Margin="0,0,8,0" Visibility="Collapsed"
                    VerticalAlignment="Center" ToolTipService.ToolTip="This page uses http, so others on the network can see or change it.">
          <FontIcon Glyph="&#xE7BA;" FontSize="12" Foreground="{StaticResource LiltTextMutedBrush}" />
          <TextBlock x:Name="InsecureText" Text="Not secure" Foreground="{StaticResource LiltTextMutedBrush}" VerticalAlignment="Center" />
        </StackPanel>
        <TextBox x:Name="AddressBox" Grid.Column="1" PlaceholderText="Search or enter address" IsSpellCheckEnabled="False"
                 InputScope="Url" AutomationProperties.Name="Address and search bar"
                 KeyDown="AddressBox_KeyDown" GotFocus="AddressBox_GotFocus" />
      </Grid>

      <StackPanel x:Name="RightPanel" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" />

      <Grid x:Name="CustomizeHost" Grid.Column="2" Width="0" HorizontalAlignment="Right">
        <FlyoutBase.AttachedFlyout>
          <Flyout x:Name="CustomizeFlyout" Placement="BottomEdgeAlignedRight" Opening="CustomizeFlyout_Opening">
            <Grid Width="360" RowSpacing="8">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <SelectorBar x:Name="CustomizeTabs" SelectionChanged="CustomizeTabs_SelectionChanged">
                <SelectorBarItem Text="Look" Tag="look" IsSelected="True" />
                <SelectorBarItem Text="Layout" Tag="layout" />
                <SelectorBarItem Text="Home" Tag="home" />
                <SelectorBarItem Text="Media" Tag="media" />
                <SelectorBarItem Text="Keys" Tag="keys" />
                <SelectorBarItem Text="Power" Tag="power" />
              </SelectorBar>
              <ScrollViewer Grid.Row="1" MaxHeight="560" Padding="0,0,12,0">
                <Grid>
                  <StackPanel x:Name="LookPage" Spacing="6">
                    <TextBlock Text="Theme" Style="{StaticResource SectionHeader}" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Button Content="Minimal" Tag="minimal" Click="Preset_Click" />
                      <Button Content="Glass" Tag="glass" Click="Preset_Click" />
                      <Button Content="Light" Tag="light" Click="Preset_Click" />
                    </StackPanel>
                    <ComboBox x:Name="MaterialCombo" Header="Window material" HorizontalAlignment="Stretch" SelectionChanged="Customize_Changed">
                      <ComboBoxItem Content="Mica (recommended)" Tag="mica" />
                      <ComboBoxItem Content="Mica Alt" Tag="micaAlt" />
                      <ComboBoxItem Content="Acrylic (stronger blur)" Tag="acrylic" />
                      <ComboBoxItem Content="Thin acrylic (clearer glass)" Tag="acrylicThin" />
                      <ComboBoxItem Content="Solid" Tag="none" />
                    </ComboBox>
                    <Slider x:Name="TintSlider" Header="Glass tint" Minimum="0" Maximum="100" StepFrequency="1" ValueChanged="Customize_Changed" />
                    <Slider x:Name="ChromeOpacitySlider" Header="Toolbar and sidebar opacity" Minimum="0" Maximum="100" StepFrequency="1" ValueChanged="Customize_Changed" />
                    <TextBlock Text="Accent" Style="{StaticResource BodyText}" />
                    <StackPanel x:Name="AccentSwatches" Orientation="Horizontal" Spacing="6" />
                    <ComboBox x:Name="ColorTokenCombo" Header="Any color" HorizontalAlignment="Stretch" SelectionChanged="ColorToken_Changed" />
                    <ColorPicker x:Name="TokenPicker" IsAlphaEnabled="True" IsMoreButtonVisible="False" IsColorChannelTextInputVisible="False"
                                 IsHexInputVisible="True" ColorSpectrumShape="Ring" ColorChanged="TokenPicker_ColorChanged" />
                    <ComboBox x:Name="FontCombo" Header="Font" HorizontalAlignment="Stretch" IsEditable="True" SelectionChanged="Customize_Changed" TextSubmitted="FontCombo_TextSubmitted" />
                    <Slider x:Name="FontSizeSlider" Header="Text size" Minimum="11" Maximum="18" StepFrequency="1" ValueChanged="Customize_Changed" />
                    <Slider x:Name="RadiusSlider" Header="Corner radius" Minimum="0" Maximum="20" StepFrequency="1" ValueChanged="Customize_Changed" />
                    <Slider x:Name="ToolbarHeightSlider" Header="Toolbar height" Minimum="32" Maximum="64" StepFrequency="2" ValueChanged="Customize_Changed" />
                    <ComboBox x:Name="DensityCombo" Header="Spacing" HorizontalAlignment="Stretch" SelectionChanged="Customize_Changed">
                      <ComboBoxItem Content="Compact" Tag="compact" />
                      <ComboBoxItem Content="Standard" Tag="standard" />
                      <ComboBoxItem Content="Comfortable" Tag="comfortable" />
                    </ComboBox>

                    <TextBlock Text="Theme file" Style="{StaticResource SectionHeader}" Margin="2,10,0,0" />
                    <TextBlock x:Name="ThemeName" Style="{StaticResource BodyText}" />
                    <TextBlock x:Name="ThemeStatus" Style="{StaticResource BodyText}" Foreground="{StaticResource LiltTextMutedBrush}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="2">
                      <Button x:Name="ReloadThemeButton" Style="{StaticResource ChromeButton}" Click="ReloadTheme_Click"
                              ToolTipService.ToolTip="Reload theme" AutomationProperties.Name="Reload theme">
                        <FontIcon Glyph="&#xE895;" />
                      </Button>
                      <Button x:Name="EditThemeButton" Style="{StaticResource ChromeButton}" Click="EditTheme_Click"
                              ToolTipService.ToolTip="Edit theme.json" AutomationProperties.Name="Edit theme file">
                        <FontIcon Glyph="&#xE70F;" />
                      </Button>
                      <Button x:Name="DataFolderButton" Style="{StaticResource ChromeButton}" Click="OpenDataFolder_Click"
                              ToolTipService.ToolTip="Open Lilt's data folder" AutomationProperties.Name="Open data folder">
                        <FontIcon Glyph="&#xE838;" />
                      </Button>
                      <Button x:Name="UserContentButton" Style="{StaticResource ChromeButton}" Click="OpenUserContent_Click"
                              ToolTipService.ToolTip="Per-site CSS and scripts folder" AutomationProperties.Name="Open user styles and scripts folder">
                        <FontIcon Glyph="&#xE943;" />
                      </Button>
                    </StackPanel>
                  </StackPanel>

                  <StackPanel x:Name="LayoutPage" Spacing="6" Visibility="Collapsed">
                    <TextBlock Text="Presets" Style="{StaticResource SectionHeader}" />
                    <VariableSizedWrapGrid Orientation="Horizontal" ItemWidth="104" ItemHeight="40">
                      <Button Content="Compact" Tag="compact" Click="LayoutPreset_Click" ToolTipService.ToolTip="Minimal chrome, left sidebar" />
                      <Button Content="Research" Tag="research" Click="LayoutPreset_Click" ToolTipService.ToolTip="Wider sidebar, more space" />
                      <Button Content="Vertical tabs" Tag="vertical" Click="LayoutPreset_Click" ToolTipService.ToolTip="Tabs on the left, no bookmarks list" />
                      <Button Content="Top tabs" Tag="top" Click="LayoutPreset_Click" ToolTipService.ToolTip="Traditional tab strip" />
                      <Button Content="Bottom bar" Tag="bottom" Click="LayoutPreset_Click" ToolTipService.ToolTip="Tabs and tools below the page" />
                    </VariableSizedWrapGrid>
                    <Slider x:Name="SidebarWidthSlider" Header="Sidebar width" Minimum="160" Maximum="420" StepFrequency="4" ValueChanged="Customize_Changed" />
                    <TextBlock Text="Toolbar (top to bottom = left to right)" Style="{StaticResource SectionHeader}" Margin="2,10,0,0" />
                    <StackPanel x:Name="ToolbarArrange" Spacing="2" />
                    <TextBlock Text="Sidebar sections" Style="{StaticResource SectionHeader}" Margin="2,10,0,0" />
                    <StackPanel x:Name="SidebarArrange" Spacing="2" />
                    <TextBlock Text="Split view" Style="{StaticResource SectionHeader}" Margin="2,10,0,0" />
                    <ComboBox x:Name="SplitOrientationCombo" Header="Panes" HorizontalAlignment="Stretch" SelectionChanged="Customize_Changed">
                      <ComboBoxItem Content="Side by side" Tag="horizontal" />
                      <ComboBoxItem Content="Stacked" Tag="vertical" />
                    </ComboBox>
                    <Slider x:Name="SplitRatioSlider" Header="First pane (%)" Minimum="15" Maximum="85" StepFrequency="1" ValueChanged="Customize_Changed" />
                    <Slider x:Name="SplitGapSlider" Header="Gap between panes" Minimum="0" Maximum="24" StepFrequency="1" ValueChanged="Customize_Changed" />
                    <TextBlock Text="Pages" Style="{StaticResource SectionHeader}" Margin="2,10,0,0" />
                    <CheckBox x:Name="PeekCheck" Content="Shift+click a link to peek at it" Click="Customize_Changed" />
                    <ComboBox x:Name="ColorSchemeCombo" Header="Websites see" HorizontalAlignment="Stretch" SelectionChanged="Customize_Changed">
                      <ComboBoxItem Content="The theme's light or dark" Tag="theme" />
                      <ComboBoxItem Content="Windows' light or dark" Tag="auto" />
                      <ComboBoxItem Content="Always light" Tag="light" />
                      <ComboBoxItem Content="Always dark" Tag="dark" />
                    </ComboBox>
                  </StackPanel>

                  <StackPanel x:Name="HomePage" Spacing="6" Visibility="Collapsed">
                    <TextBlock Text="Home tab" Style="{StaticResource SectionHeader}" />
                    <StackPanel x:Name="HomeArrange" Spacing="2" />
                    <ComboBox x:Name="BackgroundCombo" Header="Background" HorizontalAlignment="Stretch" SelectionChanged="Background_Changed">
                      <ComboBoxItem Content="None" Tag="" />
                      <ComboBoxItem Content="Hills" Tag="hills" />
                      <ComboBoxItem Content="Pick an image…" Tag="pick" />
                    </ComboBox>
                    <CheckBox x:Name="HomeGlassCheck" Content="See-through (window material shows through)" Click="Customize_Changed" />
                  </StackPanel>

                  <StackPanel x:Name="MediaPage" Spacing="6" Visibility="Collapsed">
                    <TextBlock Text="Now playing" Style="{StaticResource SectionHeader}" />
                    <ComboBox x:Name="PlayerShowCombo" Header="Show the player" HorizontalAlignment="Stretch" SelectionChanged="Customize_Changed">
                      <ComboBoxItem Content="While something plays" Tag="auto" />
                      <ComboBoxItem Content="Always" Tag="always" />
                      <ComboBoxItem Content="Never" Tag="never" />
                    </ComboBox>
                    <Slider x:Name="PlayerWidthSlider" Header="Width" Minimum="220" Maximum="520" StepFrequency="4" ValueChanged="Customize_Changed" />
                    <Slider x:Name="PlayerOpacitySlider" Header="Opacity (%)" Minimum="20" Maximum="100" StepFrequency="1" ValueChanged="Customize_Changed" />
                    <TextBlock Text="Visualizer" Style="{StaticResource SectionHeader}" Margin="2,10,0,0" />
                    <ComboBox x:Name="VisualizerShowCombo" Header="Show the visualizer" HorizontalAlignment="Stretch" SelectionChanged="Customize_Changed">
                      <ComboBoxItem Content="On music sites" Tag="auto" />
                      <ComboBoxItem Content="Whenever sound plays" Tag="always" />
                      <ComboBoxItem Content="Never" Tag="never" />
                    </ComboBox>
                    <ComboBox x:Name="VisualizerStyleCombo" Header="Style" HorizontalAlignment="Stretch" SelectionChanged="Customize_Changed">
                      <ComboBoxItem Content="Bars" Tag="bars" />
                      <ComboBoxItem Content="Mirrored bars" Tag="mirror" />
                      <ComboBoxItem Content="Wave" Tag="wave" />
                    </ComboBox>
                    <Slider x:Name="BarsSlider" Header="Bars" Minimum="8" Maximum="64" StepFrequency="1" ValueChanged="Customize_Changed" />
                    <Slider x:Name="VisualizerWidthSlider" Header="Width" Minimum="160" Maximum="640" StepFrequency="4" ValueChanged="Customize_Changed" />
                    <Slider x:Name="VisualizerHeightSlider" Header="Height" Minimum="32" Maximum="240" StepFrequency="2" ValueChanged="Customize_Changed" />
                    <Slider x:Name="VisualizerOpacitySlider" Header="Opacity (%)" Minimum="20" Maximum="100" StepFrequency="1" ValueChanged="Customize_Changed" />
                    <ComboBox x:Name="VisualizerSourceCombo" Header="Sound comes from" HorizontalAlignment="Stretch" SelectionChanged="Customize_Changed">
                      <ComboBoxItem Content="Automatic" Tag="auto" />
                      <ComboBoxItem Content="Lilt's sound output (every site)" Tag="system" />
                      <ComboBoxItem Content="The playing tab (no DRM sites)" Tag="page" />
                    </ComboBox>
                    <TextBox x:Name="MusicSitesBox" Header="Music sites (one per line)" AcceptsReturn="True" TextWrapping="NoWrap" Height="120"
                             IsSpellCheckEnabled="False" LostFocus="MusicSites_LostFocus" />
                    <TextBlock Text="More" Style="{StaticResource SectionHeader}" Margin="2,10,0,0" />
                    <ComboBox x:Name="PipShowCombo" Header="Pop-out videos (picture in picture)" HorizontalAlignment="Stretch" SelectionChanged="Customize_Changed">
                      <ComboBoxItem Content="Windows' floating window when possible" Tag="auto" />
                      <ComboBoxItem Content="Inside Lilt" Tag="always" />
                      <ComboBoxItem Content="Off" Tag="never" />
                    </ComboBox>
                    <CheckBox x:Name="AutoPipCheck" Content="Pop playing videos out when I switch tabs" Click="Customize_Changed" />
                    <CheckBox x:Name="MediaKeysCheck" Content="Media keys and Windows media controls (after restart)" Click="Customize_Changed" />
                    <Button Content="Put the player and visualizer back" Click="ResetWidgets_Click" />
                  </StackPanel>

                  <StackPanel x:Name="KeysPage" Spacing="4" Visibility="Collapsed">
                    <TextBlock Text="Keyboard shortcuts" Style="{StaticResource SectionHeader}" />
                    <TextBlock Style="{StaticResource BodyText}" Foreground="{StaticResource LiltTextMutedBrush}" TextWrapping="Wrap" FontSize="12"
                               Text="Click a box and press the keys you want. Backspace clears it. Letters need Ctrl or Alt. Shortcuts marked * also work inside pages; the rest let a page use the key first." />
                    <StackPanel x:Name="KeysList" Spacing="4" />
                    <Button Content="Restore all shortcuts" Click="ResetKeys_Click" />
                  </StackPanel>

                  <StackPanel x:Name="PowerPage" Spacing="6" Visibility="Collapsed">
                    <TextBlock Text="While you're in another app" Style="{StaticResource SectionHeader}" />
                    <ToggleSwitch x:Name="EfficiencySwitch" Header="Efficiency mode" Toggled="Customize_Changed" />
                    <TextBlock Style="{StaticResource BodyText}" Foreground="{StaticResource LiltTextMutedBrush}" TextWrapping="Wrap" FontSize="12"
                               Text="After 10 seconds away, Lilt lowers its priority, asks Windows for efficiency mode and frees page memory. Tabs playing sound keep running." />
                    <ToggleSwitch x:Name="CoveredSwitch" Header="Pause pages behind full-screen games" Toggled="Customize_Changed" />
                    <ToggleSwitch x:Name="OccludedSwitch" Header="Hide pages fully behind other windows" Toggled="Customize_Changed" />
                    <ToggleSwitch x:Name="LeanSwitch" Header="Lean mode: less memory, after restart" Toggled="Customize_Changed" />
                    <Slider x:Name="SuspendSlider" Header="Suspend unused tabs after (minutes, 0 = never)" Minimum="0" Maximum="60" StepFrequency="1" ValueChanged="Customize_Changed" />
                    <TextBlock x:Name="PowerStatus" Style="{StaticResource BodyText}" Foreground="{StaticResource LiltTextMutedBrush}" TextWrapping="Wrap" />
                    <TextBlock Text="Memory" Style="{StaticResource SectionHeader}" Margin="2,10,0,0" />
                    <Grid ColumnSpacing="6">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Button x:Name="MeasureButton" Style="{StaticResource ChromeButton}" Click="Measure_Click" VerticalAlignment="Top"
                              ToolTipService.ToolTip="Measure Lilt and its WebView2 processes now" AutomationProperties.Name="Measure memory">
                        <FontIcon Glyph="&#xE9D9;" />
                      </Button>
                      <TextBlock x:Name="MemoryText" Grid.Column="1" Style="{StaticResource BodyText}" Foreground="{StaticResource LiltTextMutedBrush}"
                                 TextWrapping="Wrap" Text="Not measured" />
                    </Grid>
                  </StackPanel>
                </Grid>
              </ScrollViewer>
            </Grid>
          </Flyout>
        </FlyoutBase.AttachedFlyout>
      </Grid>

      <Grid x:Name="PaletteHost" Grid.Column="1" Width="0" HorizontalAlignment="Center">
        <FlyoutBase.AttachedFlyout>
          <Flyout x:Name="PaletteFlyout" Placement="Bottom" Opened="PaletteFlyout_Opened" Closed="PaletteFlyout_Closed">
            <Flyout.FlyoutPresenterStyle>
              <Style TargetType="FlyoutPresenter">
                <Setter Property="MaxWidth" Value="640" />
              </Style>
            </Flyout.FlyoutPresenterStyle>
            <Grid Width="520" RowSpacing="6">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <TextBox x:Name="PaletteBox" PlaceholderText="Type a command, tab, bookmark, theme or setting" IsSpellCheckEnabled="False"
                       TextChanged="PaletteBox_TextChanged" KeyDown="PaletteBox_KeyDown" AutomationProperties.Name="Command palette" />
              <ListView x:Name="PaletteList" Grid.Row="1" MaxHeight="420" SelectionMode="Single" IsItemClickEnabled="True"
                        ItemClick="PaletteList_ItemClick" AutomationProperties.Name="Results" />
            </Grid>
          </Flyout>
        </FlyoutBase.AttachedFlyout>
      </Grid>

      <Grid x:Name="MenuHost" Grid.Column="2" Width="0" HorizontalAlignment="Right">
        <FlyoutBase.AttachedFlyout>
            <MenuFlyout x:Name="MainMenu" Placement="BottomEdgeAlignedRight" Opening="MainMenu_Opening">
              <MenuFlyoutItem Text="New tab" KeyboardAcceleratorTextOverride="Ctrl+T" Click="NewTab_Click">
                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE710;" /></MenuFlyoutItem.Icon>
              </MenuFlyoutItem>
              <MenuFlyoutItem Text="Reopen closed tab" KeyboardAcceleratorTextOverride="Ctrl+Shift+T" Click="ReopenTab_Click">
                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7A7;" /></MenuFlyoutItem.Icon>
              </MenuFlyoutItem>
              <MenuFlyoutSeparator />
              <MenuFlyoutItem Text="Bookmark this page" KeyboardAcceleratorTextOverride="Ctrl+D" Click="Star_Click">
                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE734;" /></MenuFlyoutItem.Icon>
              </MenuFlyoutItem>
              <MenuFlyoutSubItem x:Name="ImportMenu" Text="Import bookmarks">
                <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xE8B5;" /></MenuFlyoutSubItem.Icon>
              </MenuFlyoutSubItem>
              <MenuFlyoutSeparator />
              <MenuFlyoutItem x:Name="AdBlockMenuItem" Text="Ad blocker settings" Click="AdBlockSettings_Click">
                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xEA18;" /></MenuFlyoutItem.Icon>
              </MenuFlyoutItem>
              <MenuFlyoutItem x:Name="ExtensionsMenuItem" Text="Extensions" Click="Extensions_Click">
                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xEA86;" /></MenuFlyoutItem.Icon>
              </MenuFlyoutItem>
              <MenuFlyoutItem Text="Customize" KeyboardAcceleratorTextOverride="Ctrl+Shift+," Click="CustomizeMenu_Click">
                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE790;" /></MenuFlyoutItem.Icon>
              </MenuFlyoutItem>
              <MenuFlyoutItem Text="Downloads" Click="DownloadsMenu_Click">
                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE896;" /></MenuFlyoutItem.Icon>
              </MenuFlyoutItem>
              <MenuFlyoutSeparator />
              <MenuFlyoutItem Text="Print" KeyboardAcceleratorTextOverride="Ctrl+P" Click="Print_Click">
                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE749;" /></MenuFlyoutItem.Icon>
              </MenuFlyoutItem>
              <MenuFlyoutItem Text="Developer tools" KeyboardAcceleratorTextOverride="F12" Click="DevTools_Click">
                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xEC7A;" /></MenuFlyoutItem.Icon>
              </MenuFlyoutItem>
              <MenuFlyoutItem Text="Open data folder" Click="OpenDataFolder_Click">
                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE838;" /></MenuFlyoutItem.Icon>
              </MenuFlyoutItem>
              <MenuFlyoutSeparator />
              <MenuFlyoutItem x:Name="VersionItem" IsEnabled="False" />
            </MenuFlyout>
        </FlyoutBase.AttachedFlyout>
      </Grid>

      <!-- Flyouts opened from buttons that can be moved or hidden; shown at the button, or here when it's hidden. -->
      <Grid x:Name="FlyoutHost" Grid.Column="2" Width="0" HorizontalAlignment="Right">
        <FlyoutBase.AttachedFlyout>
          <Flyout x:Name="ExtensionsFlyout" Placement="BottomEdgeAlignedRight">
            <StackPanel Width="340" Spacing="8">
              <TextBlock Text="Extensions" Style="{StaticResource SectionHeader}" />
              <StackPanel x:Name="ExtensionList" Spacing="6" />
              <TextBlock Text="Add from the Chrome Web Store" Style="{StaticResource SectionHeader}" Margin="2,8,0,0" />
              <TextBox x:Name="WebStoreBox" PlaceholderText="Paste a Chrome Web Store link or ID" />
              <Button x:Name="InstallExtensionButton" Content="Install" Click="InstallExtension_Click" />
              <TextBlock Style="{StaticResource BodyText}" Foreground="{StaticResource LiltTextMutedBrush}" TextWrapping="Wrap" FontSize="12"
                         Text="Experimental. Extensions run inside Lilt's engine without a toolbar; their popups open in a small window and may not know which tab you're on. Packages are signature-checked before install." />
            </StackPanel>
          </Flyout>
        </FlyoutBase.AttachedFlyout>
      </Grid>
    </Grid>

    <!-- Content: pages plus a sidebar that docks to any edge (pinned) or floats over the page (auto-hide). -->
    <Grid x:Name="ContentArea" Grid.Row="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <!-- Pages. In split view the two visible pages get a column (or row) each, with SplitHandle between them. -->
      <Grid x:Name="PageHost" Grid.Row="1" Grid.Column="1">
        <Border x:Name="SplitHandle" Visibility="Collapsed" Canvas.ZIndex="1" Background="Transparent"
                PointerPressed="SplitHandle_PointerPressed" DoubleTapped="SplitHandle_DoubleTapped"
                ToolTipService.ToolTip="Drag to resize; double-click to make the panes equal" AutomationProperties.Name="Split view divider">
          <Border x:Name="SplitGrip" Background="{StaticResource LiltBorderBrush}" CornerRadius="2" />
        </Border>
        <Border x:Name="SplitFocus" Visibility="Collapsed" Canvas.ZIndex="2" IsHitTestVisible="False" BorderThickness="2" CornerRadius="6"
                BorderBrush="{StaticResource LiltAccentBrush}" Opacity="0.7" />
      </Grid>

      <!-- Floating widgets: drag them anywhere over the page. Positions are saved as fractions of this area. -->
      <Canvas x:Name="WidgetLayer" Grid.Row="1" Grid.Column="1" Canvas.ZIndex="1" SizeChanged="WidgetLayer_SizeChanged">
        <Border x:Name="MediaWidget" Tag="player" Visibility="Collapsed" Width="300" Padding="10" CornerRadius="12" BorderThickness="1"
                Background="{StaticResource LiltOverlayBrush}" BorderBrush="{StaticResource LiltBorderBrush}"
                PointerPressed="Widget_PointerPressed" AutomationProperties.Name="Now playing">
          <Grid ColumnSpacing="10" RowSpacing="6">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Grid.RowSpan="2" Width="52" Height="52" CornerRadius="8" Background="{StaticResource LiltSurfaceRaisedBrush}" VerticalAlignment="Top">
              <Grid>
                <FontIcon Glyph="&#xE8D6;" FontSize="20" Foreground="{StaticResource LiltTextMutedBrush}" />
                <Image x:Name="MediaArt" Stretch="UniformToFill" />
              </Grid>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock x:Name="MediaTitle" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{StaticResource LiltTextBrush}" />
              <TextBlock x:Name="MediaArtist" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{StaticResource LiltTextMutedBrush}" />
            </StackPanel>
            <Button Grid.Column="2" Style="{StaticResource ChromeButton}" Width="24" Height="24" VerticalAlignment="Top" Click="MediaClose_Click"
                    ToolTipService.ToolTip="Hide until something else plays" AutomationProperties.Name="Hide the player">
              <FontIcon Glyph="&#xE711;" FontSize="10" />
            </Button>
            <StackPanel x:Name="MediaControls" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="2">
              <Button x:Name="MediaPrev" Style="{StaticResource ChromeButton}" Width="30" Height="30" Click="MediaPrev_Click"
                      ToolTipService.ToolTip="Previous" AutomationProperties.Name="Previous">
                <FontIcon Glyph="&#xE892;" FontSize="13" />
              </Button>
              <Button x:Name="MediaPlay" Style="{StaticResource ChromeButton}" Width="30" Height="30" Click="MediaPlay_Click"
                      ToolTipService.ToolTip="Play or pause" AutomationProperties.Name="Play or pause">
                <FontIcon x:Name="MediaPlayIcon" Glyph="&#xE768;" FontSize="13" />
              </Button>
              <Button x:Name="MediaNext" Style="{StaticResource ChromeButton}" Width="30" Height="30" Click="MediaNext_Click"
                      ToolTipService.ToolTip="Next" AutomationProperties.Name="Next">
                <FontIcon Glyph="&#xE893;" FontSize="13" />
              </Button>
              <Button x:Name="MediaMute" Style="{StaticResource ChromeButton}" Width="30" Height="30" Click="MediaMute_Click"
                      ToolTipService.ToolTip="Mute the tab" AutomationProperties.Name="Mute or unmute">
                <FontIcon x:Name="MediaMuteIcon" Glyph="&#xE767;" FontSize="13" />
              </Button>
              <Button x:Name="MediaPip" Style="{StaticResource ChromeButton}" Width="30" Height="30" Click="MediaPip_Click"
                      ToolTipService.ToolTip="Picture in picture (Alt+P)" AutomationProperties.Name="Picture in picture">
                <FontIcon Glyph="&#xE8A7;" FontSize="13" />
              </Button>
              <Button x:Name="MediaVisualizer" Style="{StaticResource ChromeButton}" Width="30" Height="30" Click="MediaVisualizer_Click"
                      ToolTipService.ToolTip="Visualizer (Ctrl+Shift+U)" AutomationProperties.Name="Show or hide the visualizer">
                <FontIcon Glyph="&#xE9D9;" FontSize="13" />
              </Button>
              <Button x:Name="MediaGoTo" Style="{StaticResource ChromeButton}" Width="30" Height="30" Click="MediaGoTo_Click"
                      ToolTipService.ToolTip="Go to the tab" AutomationProperties.Name="Go to the playing tab">
                <FontIcon Glyph="&#xE72A;" FontSize="13" />
              </Button>
            </StackPanel>
            <Grid Grid.Row="2" Grid.ColumnSpan="3" ColumnSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <ProgressBar x:Name="MediaProgress" Minimum="0" Maximum="1" VerticalAlignment="Center" Background="{StaticResource LiltBorderBrush}"
                           Foreground="{StaticResource LiltAccentBrush}" PointerPressed="MediaProgress_PointerPressed" />
              <TextBlock x:Name="MediaTime" Grid.Column="1" FontSize="11" Foreground="{StaticResource LiltTextMutedBrush}" />
            </Grid>
          </Grid>
        </Border>

        <Border x:Name="VisualizerWidget" Tag="visualizer" Visibility="Collapsed" Width="300" Height="72" Padding="8" CornerRadius="12" BorderThickness="1"
                Background="{StaticResource LiltOverlayBrush}" BorderBrush="{StaticResource LiltBorderBrush}"
                PointerPressed="Widget_PointerPressed" DoubleTapped="Visualizer_DoubleTapped"
                ToolTipService.ToolTip="Drag to move; double-click to change style" AutomationProperties.Name="Visualizer">
          <Canvas x:Name="VisualizerCanvas" />
        </Border>

        <!-- A video popped out inside Lilt: this frame's bar and resize grip sit over the playing tab's page, which is
             shown in the frame's empty area underneath (see MainWindow.Media.cs). -->
        <Grid x:Name="PipFrame" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Border Tag="pip" Padding="8,0,2,0" CornerRadius="8,8,0,0" Background="{StaticResource LiltOverlayBrush}"
                  PointerPressed="Widget_PointerPressed" DoubleTapped="PipBar_DoubleTapped"
                  ToolTipService.ToolTip="Drag to move; double-click to go back to the tab" AutomationProperties.Name="Popped-out video">
            <Grid ColumnSpacing="2">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="PipTitle" VerticalAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{StaticResource LiltTextBrush}" />
              <Button Grid.Column="1" Style="{StaticResource ChromeButton}" Width="26" Height="26" Click="PipDock_Click"
                      ToolTipService.ToolTip="Back to the tab" AutomationProperties.Name="Back to the tab">
                <FontIcon Glyph="&#xE8A7;" FontSize="12" />
              </Button>
              <Button Grid.Column="2" Style="{StaticResource ChromeButton}" Width="26" Height="26" Click="PipClose_Click"
                      ToolTipService.ToolTip="Pause and put back" AutomationProperties.Name="Close the popped-out video">
                <FontIcon Glyph="&#xE711;" FontSize="10" />
              </Button>
            </Grid>
          </Border>
          <Polygon Grid.Row="1" Tag="pipsize" Points="18,0 18,18 0,18" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                   Fill="{StaticResource LiltOverlayBrush}" Stroke="{StaticResource LiltBorderBrush}"
                   PointerPressed="Widget_PointerPressed" ToolTipService.ToolTip="Drag to resize" />
        </Grid>
      </Canvas>

      <!-- Peek: a link previewed over the page (Shift+click). -->
      <Grid x:Name="PeekOverlay" Grid.Row="1" Grid.Column="1" Canvas.ZIndex="3" Visibility="Collapsed" Background="#66000000"
            Tapped="PeekOverlay_Tapped" KeyDown="PeekOverlay_KeyDown">
        <Border x:Name="PeekPanel" Margin="48,32" CornerRadius="12" BorderThickness="1" Background="{StaticResource LiltBackgroundBrush}"
                BorderBrush="{StaticResource LiltBorderBrush}" Tapped="PeekPanel_Tapped">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Padding="10,6" ColumnSpacing="6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="PeekAddress" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{StaticResource LiltTextMutedBrush}" />
              <Button Grid.Column="1" Content="Open as tab" Click="PeekOpen_Click" />
              <Button Grid.Column="2" Content="Open in split view" Click="PeekSplit_Click" />
              <Button Grid.Column="3" Style="{StaticResource ChromeButton}" Click="PeekClose_Click" ToolTipService.ToolTip="Close (Esc)" AutomationProperties.Name="Close peek">
                <FontIcon Glyph="&#xE711;" FontSize="12" />
              </Button>
            </Grid>
            <Grid x:Name="PeekHost" Grid.Row="1" />
          </Grid>
        </Border>
      </Grid>

      <Border x:Name="Sidebar" Canvas.ZIndex="1" BorderBrush="{StaticResource LiltBorderBrush}" KeyDown="Sidebar_KeyDown"
              GotFocus="Sidebar_GotFocus" LostFocus="Sidebar_LostFocus" AutomationProperties.Name="Sidebar">
        <Border.RenderTransform>
          <TranslateTransform x:Name="SlideTransform" />
        </Border.RenderTransform>
        <Grid x:Name="SidebarGrid">
          <Grid x:Name="TabsHeader" ColumnSpacing="4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TabsTitle" Text="Tabs" Style="{StaticResource SectionHeader}" VerticalAlignment="Center" />
            <Button x:Name="NewTabButton" Grid.Column="1" Style="{StaticResource ChromeButton}" Click="NewTab_Click"
                    ToolTipService.ToolTip="New tab (Ctrl+T)" AutomationProperties.Name="New tab">
              <FontIcon Glyph="&#xE710;" />
            </Button>
          </Grid>

          <ListView x:Name="TabList" SelectionMode="Single" CanReorderItems="True" CanDragItems="True" AllowDrop="True"
                    SelectionChanged="TabList_SelectionChanged" AutomationProperties.Name="Tabs">
            <ListView.ItemTemplate>
              <DataTemplate x:DataType="browser:BrowserTab">
                <Border BorderBrush="{x:Bind StateBorder, Mode=OneWay}" BorderThickness="1" CornerRadius="6" Padding="6,0,2,0" Background="Transparent"
                        PointerPressed="Tab_PointerPressed" RightTapped="Tab_RightTapped" ToolTipService.ToolTip="{x:Bind Url, Mode=OneWay}">
                  <Grid ColumnSpacing="8" MinHeight="30">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="16" Height="16" VerticalAlignment="Center">
                      <FontIcon Glyph="{x:Bind Glyph, Mode=OneWay}" FontSize="13" Foreground="{x:Bind GlyphBrush, Mode=OneWay}" Visibility="{x:Bind GlyphVisibility, Mode=OneWay}" />
                      <Image Source="{x:Bind Icon, Mode=OneWay}" Width="16" Height="16" Visibility="{x:Bind IconVisibility, Mode=OneWay}" />
                      <ProgressRing IsActive="{x:Bind IsLoading, Mode=OneWay}" Width="14" Height="14" MinWidth="0" MinHeight="0" Visibility="{x:Bind IsLoading, Mode=OneWay}" />
                    </Grid>
                    <TextBlock Grid.Column="1" Text="{x:Bind DisplayTitle, Mode=OneWay}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                               Visibility="{x:Bind LabelVisibility, Mode=OneWay}" />
                    <Button Grid.Column="2" Style="{StaticResource ChromeButton}" Width="22" Height="22" CornerRadius="4" Click="TabAudio_Click"
                            Visibility="{x:Bind AudioVisibility, Mode=OneWay}" ToolTipService.ToolTip="Mute or unmute" AutomationProperties.Name="Mute or unmute tab">
                      <FontIcon Glyph="{x:Bind AudioGlyph, Mode=OneWay}" FontSize="11" />
                    </Button>
                    <Button Grid.Column="3" Style="{StaticResource ChromeButton}" Width="22" Height="22" CornerRadius="4" Click="CloseTab_Click"
                            Visibility="{x:Bind LabelVisibility, Mode=OneWay}" ToolTipService.ToolTip="Close tab (Ctrl+W)" AutomationProperties.Name="Close tab">
                      <FontIcon Glyph="&#xE711;" FontSize="10" Foreground="{x:Bind GlyphBrush, Mode=OneWay}" />
                    </Button>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>

          <Grid x:Name="BookmarksPanel" RowSpacing="4">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="Bookmarks" Style="{StaticResource SectionHeader}" VerticalAlignment="Center" />
              <Button x:Name="BookmarkImportButton" Grid.Column="1" Style="{StaticResource ChromeButton}"
                      ToolTipService.ToolTip="Import bookmarks" AutomationProperties.Name="Import bookmarks">
                <FontIcon Glyph="&#xE8B5;" />
                <Button.Flyout>
                  <MenuFlyout x:Name="ImportFlyout" Opening="ImportFlyout_Opening" />
                </Button.Flyout>
              </Button>
            </Grid>
            <TextBox x:Name="BookmarkSearch" Grid.Row="1" PlaceholderText="Search bookmarks" TextChanged="BookmarkSearch_TextChanged"
                     AutomationProperties.Name="Search bookmarks" />
            <ListView x:Name="BookmarkList" Grid.Row="2" MaxHeight="300" SelectionMode="None" IsItemClickEnabled="True"
                      ItemClick="BookmarkList_ItemClick" RightTapped="BookmarkList_RightTapped" AutomationProperties.Name="Bookmarks">
              <ListView.ItemTemplate>
                <DataTemplate x:DataType="bm:Bookmark">
                  <StackPanel Padding="0,4" ToolTipService.ToolTip="{x:Bind Url}">
                    <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{x:Bind Folder}" FontSize="11" Foreground="{StaticResource LiltTextMutedBrush}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </DataTemplate>
              </ListView.ItemTemplate>
              <FlyoutBase.AttachedFlyout>
                <MenuFlyout x:Name="BookmarkMenu">
                  <MenuFlyoutItem Text="Open in new tab" Click="BookmarkNewTab_Click" />
                  <MenuFlyoutItem Text="Remove" Click="BookmarkRemove_Click" />
                </MenuFlyout>
              </FlyoutBase.AttachedFlyout>
            </ListView>
          </Grid>

          <StackPanel x:Name="SidebarFooter" Orientation="Horizontal" Spacing="2">
            <ToggleButton x:Name="EdgeLeft" Tag="Left" Style="{StaticResource ChromeToggle}" Click="Edge_Click"
                          ToolTipService.ToolTip="Dock left" AutomationProperties.Name="Dock left">
              <FontIcon Glyph="&#xE90C;" />
            </ToggleButton>
            <ToggleButton x:Name="EdgeRight" Tag="Right" Style="{StaticResource ChromeToggle}" Click="Edge_Click"
                          ToolTipService.ToolTip="Dock right" AutomationProperties.Name="Dock right">
              <FontIcon Glyph="&#xE90D;" />
            </ToggleButton>
            <ToggleButton x:Name="EdgeTop" Tag="Top" Style="{StaticResource ChromeToggle}" Click="Edge_Click"
                          ToolTipService.ToolTip="Dock top" AutomationProperties.Name="Dock top">
              <FontIcon Glyph="&#xE90E;" RenderTransformOrigin="0.5,0.5">
                <FontIcon.RenderTransform>
                  <RotateTransform Angle="180" />
                </FontIcon.RenderTransform>
              </FontIcon>
            </ToggleButton>
            <ToggleButton x:Name="EdgeBottom" Tag="Bottom" Style="{StaticResource ChromeToggle}" Click="Edge_Click"
                          ToolTipService.ToolTip="Dock bottom" AutomationProperties.Name="Dock bottom">
              <FontIcon Glyph="&#xE90E;" />
            </ToggleButton>
            <ToggleButton x:Name="PinToggle" Style="{StaticResource ChromeToggle}" Click="Pin_Click" Margin="6,0,0,0"
                          ToolTipService.ToolTip="Pinned (off: auto-hide, reveal from the edge)" AutomationProperties.Name="Pin sidebar">
              <FontIcon Glyph="&#xE718;" />
            </ToggleButton>
          </StackPanel>
        </Grid>
      </Border>

      <InfoBar x:Name="NoticeBar" Grid.Row="1" Grid.Column="1" Canvas.ZIndex="4" IsOpen="False" IsClosable="True"
               VerticalAlignment="Bottom" HorizontalAlignment="Center" MaxWidth="680" Margin="16" />
    </Grid>

  </Grid>
</Window>
